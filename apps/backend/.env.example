INFRAMELD_ENVIRONMENT=local
INFRAMELD_LOG_LEVEL=INFO
INFRAMELD_LOG_FORMAT=console

# Provision the host-managed key as described in apps/backend/README.md.
# INFRAMELD_REQUEST_FINGERPRINT__KEY_FILE=/etc/inframeld/secrets/idempotency_fingerprint_hmac.key
# or for Mac:
# INFRAMELD_REQUEST_FINGERPRINT__KEY_FILE=/Users/<USERNAME>/.config/inframeld/secrets/idempotency_fingerprint_hmac.key


INFRAMELD_DATABASE__HOST=127.0.0.1
INFRAMELD_DATABASE__PORT=15432
INFRAMELD_DATABASE__NAME=inframeld
INFRAMELD_DATABASE__USER=inframeld
INFRAMELD_DATABASE__PASSWORD=inframeld-dev-only

INFRAMELD_DATABASE__POOL_SIZE=10
INFRAMELD_DATABASE__MAX_OVERFLOW=20

INFRAMELD_DATABASE__CONNECT_TIMEOUT_SECONDS=5
INFRAMELD_DATABASE__STARTUP_TIMEOUT_SECONDS=10
INFRAMELD_DATABASE__POOL_TIMEOUT_SECONDS=30

INFRAMELD_KRATOS__PUBLIC_URL=http://127.0.0.1:14434
INFRAMELD_KRATOS__AUTHORITY=kratos:local

INFRAMELD_CSRF__TRUSTED_ORIGINS='["http://127.0.0.1:8000"]'

# Limits for cookie and bearer authentication, including the local principal lookup.
INFRAMELD_HUMAN_AUTHENTICATION__PROVIDER_TIMEOUT_SECONDS=5
INFRAMELD_HUMAN_AUTHENTICATION__TOTAL_TIMEOUT_SECONDS=10

# Host API settings. Containerized development supplies private provider URLs.
# Run pnpm dev:oauth:configure to reconcile its CLI client without publishing admin.
# Provider lifetimes belong in root .env, based on the root .env.example.
# A host process needs its own private network access for these administration URLs.
# The public URL is required for the browser consent API, not inferred from admin_url.
# INFRAMELD_KRATOS__ADMIN_URL=http://kratos:4434
# INFRAMELD_HYDRA__ADMIN_URL=http://hydra:4445
# INFRAMELD_HYDRA__PUBLIC_URL=https://auth.example.test
# INFRAMELD_HYDRA__ISSUER=https://auth.example.test/
# INFRAMELD_HYDRA__API_AUDIENCE=https://api.example.test
# Approval-screen convenience only - does not change token or login lifetimes.
# INFRAMELD_HYDRA__REMEMBER_CONSENT_SECONDS=3600

# Private recovery process only, not required by the public API.
# Supply an operator-owned key file readable by its runtime UID and with mode 0400 or 0600.
# INFRAMELD_RECOVERY__AUTHORITY=kratos:local
# INFRAMELD_RECOVERY__CURRENT_KEY_FILE=/run/secrets/recovery_hook_key
# INFRAMELD_RECOVERY__RETIRING_KEY_FILE=/run/secrets/recovery_hook_retiring
# INFRAMELD_RECOVERY__RETIRING_KEY_ACCEPT_UNTIL=2026-11-01T00:00:00Z
# INFRAMELD_RECOVERY__REQUEST_TIMEOUT_SECONDS=10
# INFRAMELD_RECOVERY__DATABASE_TIMEOUT_SECONDS=5
