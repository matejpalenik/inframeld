FROM python:3.13.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.15 /uv /uvx /bin/

ENV UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/backend

# The locked Hydra SDK is installed from a Git revision.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY apps/backend/pyproject.toml apps/backend/uv.lock ./
RUN uv sync --locked --no-install-project

COPY apps/backend/README.md ./README.md
COPY apps/backend/src ./src
RUN uv sync --locked --no-editable

RUN groupadd --system --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home app

ENV PATH="/opt/backend/.venv/bin:$PATH" \
    PYTHONPATH=/workspace/apps/backend/src

WORKDIR /workspace/apps/backend
USER app:app
