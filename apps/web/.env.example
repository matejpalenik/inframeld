# Default localhost HTTP development does not support the recipient-proof producer.
# These values belong to the separate private HTTPS reference profile.
INFRAMELD_ACCOUNT_PUBLIC_ORIGIN=https://inframeld.account.test:8443
INFRAMELD_ACCOUNT_HYDRA_ORIGIN=https://hydra.account.test:8443
INFRAMELD_ACCOUNT_API_INTERNAL_URL=http://backend:8000
INFRAMELD_ACCOUNT_KRATOS_INTERNAL_URL=http://kratos:4433
# All required upstream authorization/navigation origins, independent of issuer trust.
# Optional server-only JSON list of exact HTTPS origins, at most eight. No wildcards.
INFRAMELD_ACCOUNT_OIDC_FORM_ACTION_ORIGINS=[]
