{
  "name": "@inframeld/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build:sdk": "pnpm --filter @inframeld/sdk --fail-if-no-match build",
    "dev": "pnpm run build:sdk && next dev",
    "build": "pnpm run build:sdk && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "typecheck": "pnpm run build:sdk && tsc --noEmit",
    "test": "pnpm run build:sdk && tsx --test tests/unit/*.test.ts*",
    "test:browser": "tsx --test --test-concurrency=1 tests/browser/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@inframeld/sdk": "workspace:*",
    "@ory/client-fetch": "1.22.66",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
