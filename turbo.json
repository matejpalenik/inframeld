{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["INFRAMELD_*"]
    },
    "openapi": {
      "cache": false,
      "env": ["INFRAMELD_*"]
    },
    "openapi:check": {
      "env": ["INFRAMELD_*"]
    },
    "lint": {},
    "typecheck": {},
    "@inframeld/web#typecheck": {
      "dependsOn": ["@inframeld/sdk#build"]
    },
    "test": {
      "env": ["INFRAMELD_*"]
    },
    "@inframeld/web#test": {
      "dependsOn": ["@inframeld/sdk#build"],
      "env": ["INFRAMELD_*"]
    },
    "format": {},
    "format:check": {}
  }
}
