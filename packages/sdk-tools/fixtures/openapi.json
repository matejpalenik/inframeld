      "ContractFixturePayload": {
        "description": "Exercise required, nullable, union, and constrained fields on a test-only route.",
        "properties": {
          "choice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Choice"
          },
          "optional_nullable": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Optional Nullable"
          },
          "required_name": {
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[a-z]+$",
            "title": "Required Name",
            "type": "string"
          },
          "required_nullable": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Required Nullable"
          },
          "score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
