          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractFixtureAcceptedResponseDTO"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "Variant Response"
      }
