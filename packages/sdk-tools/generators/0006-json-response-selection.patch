+    fn json_response_alternatives<'a>(analysis: &'a SchemaAnalysis, operation: &'a OperationInfo) -> Vec<(&'a str, &'a str, &'a str)> {
+        let Some(responses) = analysis.operation_responses.get(&operation.operation_id) else { return Vec::new(); };
+        let mut alternatives = Vec::new();
+        for (status, response) in responses.iter().filter(|(status, _)| status.starts_with('2')) {
+            if response.representations.is_empty() { return Vec::new(); }
+            for (media_type, representation) in &response.representations {
+                let OperationRepresentation::Json { schema_name } = representation else { return Vec::new(); };
+                alternatives.push((status.as_str(), media_type.as_str(), schema_name.as_str()));
+            }
+        }
+        alternatives
+    }
+
+    fn json_response_enum_name(&self, operation: &OperationInfo) -> syn::Ident {
+        Self::to_field_ident(&format!("{}HttpResponseBody", self.to_rust_type_name(&operation.operation_id)))
+    }
+
+    fn generate_json_response_enum(&self, plan: &ClientMethodPlan<'_>) -> TokenStream {
+        let name = self.json_response_enum_name(plan.operation);
+        let variants = plan.json_alternatives.iter().enumerate().map(|(index, (status, _, schema))| {
+            let variant = Self::to_field_ident(&format!("Status{}Representation{}", status, index));
+            let ty = Self::to_field_ident(&self.to_rust_type_name(schema));
+            quote! { #variant(super::types::#ty) }
+        });
+        quote! {
+            #[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
+            #[serde(untagged)]
+            pub enum #name { #(#variants),* }
+        }
+    }
+
+    fn generate_json_media_helper() -> TokenStream {
+        quote! {
+            fn __json_response_representation(headers: &reqwest::header::HeaderMap, declared: &[&str]) -> Result<usize, String> {
+                let Some(supplied) = headers.get(reqwest::header::CONTENT_TYPE) else {
+                    return if declared.len() == 1 { Ok(0) } else { Err("Ambiguous missing response Content-Type".into()) };
+                };
+                let supplied = supplied.to_str().map_err(|error| error.to_string())?.split(';').next().unwrap_or("").trim().to_ascii_lowercase();
+                let exact = declared.iter().position(|item| item.eq_ignore_ascii_case(&supplied));
+                let wildcard = supplied.split_once('/').and_then(|(kind, _)| declared.iter().position(|item| item.eq_ignore_ascii_case(&format!("{kind}/*"))));
+                exact.or(wildcard).or_else(|| declared.iter().position(|item| *item == "*/*")).ok_or_else(|| format!("Unexpected response Content-Type {supplied}"))
+            }
+        }
+    }
+
+    fn generate_json_response_decode(&self, operation: &OperationInfo, alternatives: &[(&str, &str, &str)]) -> TokenStream {
+        let name = self.json_response_enum_name(operation);
+        let statuses: std::collections::BTreeSet<_> = alternatives.iter().map(|item| item.0).collect();
+        let branches = statuses.into_iter().map(|status| {
+            let guard = Self::single_status_guard(status);
+            let entries: Vec<_> = alternatives.iter().enumerate().filter(|(_, item)| item.0 == status).collect();
+            let media: Vec<_> = entries.iter().map(|(_, item)| item.1).collect();
+            let arms = entries.iter().enumerate().map(|(selection, (index, (_, _, schema)))| {
+                let variant = Self::to_field_ident(&format!("Status{}Representation{}", status, index));
+                let ty = Self::to_field_ident(&self.to_rust_type_name(schema));
+                quote! { #selection => serde_json::from_slice::<super::types::#ty>(&raw_body).map(#name::#variant).map_err(|error| error.to_string()) }
+            });
+            quote! {
+                if #guard {
+                    return match __json_response_representation(&headers, &[#(#media),*])? {
+                        #(#arms),*,
+                        _ => unreachable!(),
+                    };
+                }
+            }
+        });
+        quote! { (|| -> Result<#name, String> { #(#branches)* Err("No declared JSON response matched the status".into()) })() }
+    }
