# Compose provider settings. Copy to the ignored root .env to override defaults.
# These differ from apps/backend/.env, which configures the host API process.
TTL_ACCESS_TOKEN=5m
TTL_REFRESH_TOKEN=168h
TTL_AUTH_CODE=1m
SESSION_LIFESPAN=8h

# Required by the jobs profile, using an operator-provisioned private S3 endpoint.
# Empty values keep other profiles usable and make the worker reject startup.
# INFRAMELD_ARTIFACT_STORAGE__ENDPOINT_URL=https://storage.example.test
# INFRAMELD_ARTIFACT_STORAGE__BUCKET=private-artifacts
# INFRAMELD_ARTIFACT_STORAGE__ACCESS_KEY_ID=operator-supplied
# INFRAMELD_ARTIFACT_STORAGE__SECRET_ACCESS_KEY=operator-supplied
# INFRAMELD_ARTIFACT_STORAGE__REGION=us-east-1
# Optional CA path must already be readable inside the container, for example
# through an operator-provided read-only mount. Omit it to use system trust.
# INFRAMELD_ARTIFACT_STORAGE__CA_BUNDLE=/run/artifact-storage/ca.pem

# Optional native settings retain the pinned providers' defaults when omitted.
# TTL_ID_TOKEN=1h
# TTL_LOGIN_CONSENT_REQUEST=30m
# TTL_AUTHENTICATION_SESSION=720h
# URLS_CONSENT=http://127.0.0.1:<account-ui-port>/consent
# SELFSERVICE_FLOWS_LOGIN_UI_URL=http://127.0.0.1:<account-ui-port>/login
