{
  "components": {
    "schemas": {
      "AcceptedOperationLookupResponse": {
        "additionalProperties": false,
        "description": "Confirm retained admission while making unknown dispatch and references explicit.",
        "properties": {
          "admission": {
            "const": "confirmed",
            "default": "confirmed",
            "title": "Admission",
            "type": "string"
          },
          "dispatch": {
            "const": "not_established",
            "default": "not_established",
            "title": "Dispatch",
            "type": "string"
          },
          "idempotencyExpiresAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotencyexpiresat"
          },
          "jobId": {
            "title": "Jobid",
            "type": "null"
          },
          "jobReference": {
            "const": "unknown",
            "default": "unknown",
            "title": "Jobreference",
            "type": "string"
          },
          "operationId": {
            "title": "Operationid",
            "type": "string"
          },
          "outcome": {
            "const": "accepted_asynchronous",
            "default": "accepted_asynchronous",
            "title": "Outcome",
            "type": "string"
          }
        },
        "required": [
          "operationId",
          "jobId",
          "idempotencyExpiresAt"
        ],
        "title": "AcceptedOperationLookupResponse",
        "type": "object"
      },
      "CompletedOperationLookupResponse": {
        "additionalProperties": false,
        "description": "Expose safe synchronous outcome metadata without replaying content.",
        "properties": {
          "classification": {
            "enum": [
              "safe_result",
              "issued_secret",
              "answer_receipt"
            ],
            "title": "Classification",
            "type": "string"
          },
          "idempotencyExpiresAt": {
            "format": "date-time",
            "title": "Idempotencyexpiresat",
            "type": "string"
          },
          "operationId": {
            "title": "Operationid",
            "type": "string"
          },
          "outcome": {
            "const": "completed_synchronous",
            "default": "completed_synchronous",
            "title": "Outcome",
            "type": "string"
          }
        },
        "required": [
          "operationId",
          "classification",
          "idempotencyExpiresAt"
        ],
        "title": "CompletedOperationLookupResponse",
        "type": "object"
      },
      "CurrentSessionResponse": {
        "properties": {
          "principalId": {
            "format": "uuid",
            "title": "Principalid",
            "type": "string"
          }
        },
        "required": [
          "principalId"
        ],
        "title": "CurrentSessionResponse",
        "type": "object"
      },
      "HumanOAuthConsentDecisionResponse": {
        "properties": {
          "redirectTo": {
            "title": "Redirectto",
            "type": "string"
          }
        },
        "required": [
          "redirectTo"
        ],
        "title": "HumanOAuthConsentDecisionResponse",
        "type": "object"
      },
      "HumanOAuthConsentDetailsResponse": {
        "description": "Display checked access to Alice, without granting authority for a later POST.",
        "properties": {
          "accountSubject": {
            "title": "Accountsubject",
            "type": "string"
          },
          "approvalRequired": {
            "title": "Approvalrequired",
            "type": "boolean"
          },
          "clientId": {
            "title": "Clientid",
            "type": "string"
          },
          "installation": {
            "title": "Installation",
            "type": "string"
          },
          "rememberConsentSeconds": {
            "title": "Rememberconsentseconds",
            "type": "integer"
          },
          "requestedAudience": {
            "items": {
              "type": "string"
            },
            "title": "Requestedaudience",
            "type": "array"
          },
          "requestedScopes": {
            "items": {
              "$ref": "#/components/schemas/HumanOAuthScope"
            },
            "title": "Requestedscopes",
            "type": "array"
          }
        },
        "required": [
          "accountSubject",
          "installation",
          "clientId",
          "requestedScopes",
          "requestedAudience",
          "approvalRequired",
          "rememberConsentSeconds"
        ],
        "title": "HumanOAuthConsentDetailsResponse",
        "type": "object"
      },
      "HumanOAuthConsentRequest": {
        "additionalProperties": false,
        "description": "Choose a consent decision - account, access and lifetime come from the server.",
        "properties": {
          "consentChallenge": {
            "format": "password",
            "minLength": 1,
            "title": "Consentchallenge",
            "type": "string",
            "writeOnly": true
          },
          "decision": {
            "$ref": "#/components/schemas/OAuthConsentDecision"
          },
          "remember": {
            "default": false,
            "title": "Remember",
            "type": "boolean"
          }
        },
        "required": [
          "consentChallenge",
          "decision"
        ],
        "title": "HumanOAuthConsentRequest",
        "type": "object"
      },
      "HumanOAuthScope": {
        "enum": [
          "openid",
          "offline_access",
          "inframeld:api"
        ],
        "title": "HumanOAuthScope",
        "type": "string"
      },
      "InProgressOperationLookupResponse": {
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "title": "Operationid",
            "type": "string"
          },
          "outcome": {
            "const": "in_progress",
            "default": "in_progress",
            "title": "Outcome",
            "type": "string"
          }
        },
        "required": [
          "operationId"
        ],
        "title": "InProgressOperationLookupResponse",
        "type": "object"
      },
      "InframeldDiscoveryResponse": {
        "additionalProperties": false,
        "description": "Bind the fixed CLI profile to the persistent public installation identity.",
        "properties": {
          "client_id": {
            "const": "inframeld-cli",
            "title": "Client Id",
            "type": "string"
          },
          "installation_id": {
            "format": "uuid",
            "title": "Installation Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "schema_version",
          "installation_id",
          "client_id"
        ],
        "title": "InframeldDiscoveryResponse",
        "type": "object"
      },
      "OAuthConsentDecision": {
        "enum": [
          "allow",
          "deny"
        ],
        "title": "OAuthConsentDecision",
        "type": "string"
      },
      "OperationLookupAuthorityFamily": {
        "description": "Select a fixed current-authority check without granting permission.",
        "enum": [
          "project_action_use",
          "project_grant_read",
          "organization_action_use"
        ],
        "title": "OperationLookupAuthorityFamily",
        "type": "string"
      },
      "OperationLookupAuthorityRequest": {
        "additionalProperties": false,
        "properties": {
          "actionId": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Actionid",
            "type": "string"
          },
          "family": {
            "$ref": "#/components/schemas/OperationLookupAuthorityFamily"
          }
        },
        "required": [
          "family",
          "actionId"
        ],
        "title": "OperationLookupAuthorityRequest",
        "type": "object"
      },
      "OperationLookupResponse": {
        "discriminator": {
          "mapping": {
            "accepted_asynchronous": "#/components/schemas/AcceptedOperationLookupResponse",
            "completed_synchronous": "#/components/schemas/CompletedOperationLookupResponse",
            "in_progress": "#/components/schemas/InProgressOperationLookupResponse",
            "recovery_required": "#/components/schemas/RecoveryRequiredOperationLookupResponse",
            "unresolved": "#/components/schemas/UnresolvedOperationLookupResponse"
          },
          "propertyName": "outcome"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/CompletedOperationLookupResponse"
          },
          {
            "$ref": "#/components/schemas/AcceptedOperationLookupResponse"
          },
          {
            "$ref": "#/components/schemas/InProgressOperationLookupResponse"
          },
          {
            "$ref": "#/components/schemas/RecoveryRequiredOperationLookupResponse"
          },
          {
            "$ref": "#/components/schemas/UnresolvedOperationLookupResponse"
          }
        ]
      },
      "OriginalOperationLookupRequest": {
        "additionalProperties": false,
        "properties": {
          "expectedAuthority": {
            "$ref": "#/components/schemas/OperationLookupAuthorityRequest"
          },
          "installationId": {
            "format": "uuid",
            "title": "Installationid",
            "type": "string"
          },
          "key": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "method": {
            "enum": [
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ],
            "title": "Method",
            "type": "string"
          },
          "organizationId": {
            "format": "uuid",
            "title": "Organizationid",
            "type": "string"
          },
          "projectId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Projectid"
          },
          "requestedRoute": {
            "minLength": 1,
            "title": "Requestedroute",
            "type": "string"
          }
        },
        "required": [
          "installationId",
          "organizationId",
          "projectId",
          "method",
          "requestedRoute",
          "key",
          "expectedAuthority"
        ],
        "title": "OriginalOperationLookupRequest",
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "description": "Represent an Inframeld HTTP error using RFC 9457 Problem Details.\n\nAttributes:\n    type: Absolute problem URI; about:blank is used for generic HTTP errors.\n    title: Short public summary without occurrence-specific internal data.\n    status: Error status in the range 400 through 599.\n    detail: Safe public explanation selected by the HTTP adapter.\n    code: Stable public code; clients must tolerate unfamiliar future codes.\n    request_id: Correlation UUID serialized as requestId, never authorization.\n    errors: Optional bounded collection of already sanitized request issues.\n\nThe response builder enforces the selected definition's type/code/status\npairing and whether errors is appropriate. This model does not map Python\nexceptions, authenticate callers, authorize retries, or render tracebacks.\nServer-side extra fields are rejected; client parsers must still tolerate\nfuture RFC extension members.",
        "properties": {
          "code": {
            "description": "Stable Inframeld code paired with the problem type.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "description": "Reviewed explanation without internal or submitted sensitive values.",
            "maxLength": 512,
            "minLength": 1,
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "maxItems": 20,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "At most 20 sanitized issues; the list may be incomplete.",
            "title": "Errors"
          },
          "operationId": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Original operation identity for an in-progress idempotency retry.",
            "title": "Operationid"
          },
          "requestId": {
            "description": "Server request identifier, also returned in X-Request-ID.",
            "format": "uuid",
            "title": "Requestid",
            "type": "string"
          },
          "status": {
            "description": "HTTP error status, equal to the actual response status.",
            "maximum": 599.0,
            "minimum": 400.0,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Stable human-readable summary of the problem type.",
            "maxLength": 128,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "Primary RFC 9457 problem-type URI.",
            "format": "uri",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "requestId"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ProjectUseOnlyGrantRequest": {
        "properties": {
          "actionId": {
            "const": "create-access-groups",
            "title": "Actionid",
            "type": "string"
          },
          "expectedAccessRevision": {
            "minimum": 0.0,
            "title": "Expectedaccessrevision",
            "type": "integer"
          },
          "recipientPrincipalId": {
            "format": "uuid",
            "title": "Recipientprincipalid",
            "type": "string"
          }
        },
        "required": [
          "recipientPrincipalId",
          "actionId",
          "expectedAccessRevision"
        ],
        "title": "ProjectUseOnlyGrantRequest",
        "type": "object"
      },
      "ProjectUseOnlyGrantResponse": {
        "description": "Describe the original change - current grants require a fresh authorized read.",
        "properties": {
          "accessRevision": {
            "title": "Accessrevision",
            "type": "integer"
          },
          "actionId": {
            "const": "create-access-groups",
            "title": "Actionid",
            "type": "string"
          },
          "canGrant": {
            "const": false,
            "default": false,
            "title": "Cangrant",
            "type": "boolean"
          },
          "idempotencyExpiresAt": {
            "format": "date-time",
            "title": "Idempotencyexpiresat",
            "type": "string"
          },
          "operationId": {
            "title": "Operationid",
            "type": "string"
          },
          "projectId": {
            "format": "uuid",
            "title": "Projectid",
            "type": "string"
          },
          "recipientPrincipalId": {
            "format": "uuid",
            "title": "Recipientprincipalid",
            "type": "string"
          }
        },
        "required": [
          "operationId",
          "projectId",
          "recipientPrincipalId",
          "actionId",
          "accessRevision",
          "idempotencyExpiresAt"
        ],
        "title": "ProjectUseOnlyGrantResponse",
        "type": "object"
      },
      "ProtectedResourceMetadataResponse": {
        "additionalProperties": false,
        "description": "Publish the bounded first-party RFC 9728 profile, not private provider configuration.",
        "properties": {
          "authorization_servers": {
            "maxItems": 1,
            "minItems": 1,
            "prefixItems": [
              {
                "type": "string"
              }
            ],
            "title": "Authorization Servers",
            "type": "array"
          },
          "bearer_methods_supported": {
            "maxItems": 1,
            "minItems": 1,
            "prefixItems": [
              {
                "const": "header",
                "type": "string"
              }
            ],
            "title": "Bearer Methods Supported",
            "type": "array"
          },
          "inframeld": {
            "$ref": "#/components/schemas/InframeldDiscoveryResponse"
          },
          "resource": {
            "title": "Resource",
            "type": "string"
          },
          "scopes_supported": {
            "maxItems": 1,
            "minItems": 1,
            "prefixItems": [
              {
                "const": "inframeld:api",
                "type": "string"
              }
            ],
            "title": "Scopes Supported",
            "type": "array"
          }
        },
        "required": [
          "resource",
          "authorization_servers",
          "scopes_supported",
          "bearer_methods_supported",
          "inframeld"
        ],
        "title": "ProtectedResourceMetadataResponse",
        "type": "object"
      },
      "RecoveryRequiredOperationLookupResponse": {
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "title": "Operationid",
            "type": "string"
          },
          "outcome": {
            "const": "recovery_required",
            "default": "recovery_required",
            "title": "Outcome",
            "type": "string"
          },
          "reason": {
            "const": "original_outcome_requires_recovery",
            "default": "original_outcome_requires_recovery",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "operationId"
        ],
        "title": "RecoveryRequiredOperationLookupResponse",
        "type": "object"
      },
      "UnresolvedOperationLookupResponse": {
        "additionalProperties": false,
        "properties": {
          "outcome": {
            "const": "unresolved",
            "default": "unresolved",
            "title": "Outcome",
            "type": "string"
          }
        },
        "title": "UnresolvedOperationLookupResponse",
        "type": "object"
      },
      "ValidationIssue": {
        "additionalProperties": false,
        "description": "Describe one sanitized issue in an incoming request.\n\nAttributes:\n    location: Request component containing the issue.\n    path: Verified public field names or array indices, relative to that\n        component. An empty path identifies the component as a whole.\n    code: Product-owned validation category, independent of library names.\n    message: Reviewed corrective description without submitted values.\n\nThis model checks the output shape, not whether a string contains a secret.\nThe validation translator must sanitize locations and messages first.",
        "properties": {
          "code": {
            "description": "Stable Inframeld validation category.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Code",
            "type": "string"
          },
          "location": {
            "description": "Request component containing the issue.",
            "enum": [
              "body",
              "path",
              "query",
              "header",
              "cookie",
              "request"
            ],
            "title": "Location",
            "type": "string"
          },
          "message": {
            "description": "Safe corrective description without submitted values.",
            "maxLength": 256,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "path": {
            "description": "Verified public fields and indices relative to the request component.",
            "items": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "minimum": 0.0,
                  "type": "integer"
                }
              ]
            },
            "maxItems": 8,
            "title": "Path",
            "type": "array"
          }
        },
        "required": [
          "location",
          "path",
          "code",
          "message"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HumanBearer": {
        "description": "Opaque human Hydra access token. Application keys do not authenticate a human.",
        "scheme": "bearer",
        "type": "http"
      },
      "KratosSession": {
        "description": "Kratos browser session. Cookie-authenticated writes also require a trusted Origin and X-Inframeld-CSRF: 1.",
        "in": "cookie",
        "name": "ory_kratos_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Governed retrieval and release workflows.",
    "title": "Inframeld API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/oauth-protected-resource": {
      "get": {
        "description": "Read anonymous public metadata for a root API identity.",
        "operationId": "getProtectedResourceMetadata",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtectedResourceMetadataResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Resource not found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Request validation failed"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Dependency unavailable"
          }
        },
        "summary": "Root Metadata",
        "tags": [
          "discovery"
        ]
      }
    },
    "/.well-known/oauth-protected-resource/{resource_path}": {
      "get": {
        "description": "Read anonymous public metadata for the exact configured API path.",
        "operationId": "getProtectedResourceMetadataForPath",
        "parameters": [
          {
            "description": "Percent-encoded relative resource path. Preserve slash separators and existing percent escapes.",
            "in": "path",
            "name": "resource_path",
            "required": true,
            "schema": {
              "description": "Percent-encoded relative resource path. Preserve slash separators and existing percent escapes.",
              "title": "Resource Path",
              "type": "string",
              "x-inframeld-encoded-path": true
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtectedResourceMetadataResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Resource not found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Request validation failed"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Dependency unavailable"
          }
        },
        "summary": "Path Metadata",
        "tags": [
          "discovery"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Gethealth",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/oauth/consent": {
      "get": {
        "operationId": "inspectHumanOAuthConsent",
        "parameters": [
          {
            "in": "query",
            "name": "consent_challenge",
            "required": true,
            "schema": {
              "format": "password",
              "minLength": 1,
              "title": "Consent Challenge",
              "type": "string",
              "writeOnly": true
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanOAuthConsentDetailsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid authentication request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Access denied"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Resource not found"
          },
          "422": {
            "content": {
