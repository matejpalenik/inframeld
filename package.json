{
  "name": "inframeld",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm openapi:check",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "pnpm exec prettier --write --ignore-unknown . && pnpm --filter @inframeld/backend format",
    "format:check": "pnpm exec prettier --check --ignore-unknown . && pnpm --filter @inframeld/backend format:check",
    "openapi": "turbo run openapi --filter=@inframeld/backend",
    "openapi:check": "turbo run openapi:check --filter=@inframeld/backend",
    "commit": "cz",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "engines": {
    "node": "26.6.0",
    "pnpm": "12.4.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.13"
  },
  "packageManager": "pnpm@12.4.0"
}
